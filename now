SQL> DECLARE
  2  v_student_id NUMBER := 999;
  3  v_name VARCHAR2(50);
  4  student_not_found EXCEPTION;
  5  BEGIN
  6  SELECT studentname
  7  INTO v_name
  8  FROM gstudent
  9  WHERE studentid = v_student_id;
 10  DBMS_OUTPUT.PUT_LINE('Student found: ' || v_name);
 11  EXCEPTION
 12  WHEN NO_DATA_FOUND THEN
 13  DBMS_OUTPUT.PUT_LINE('Error: Student ID does not exist');
 14  END;
 15  /

PL/SQL procedure successfully completed.

