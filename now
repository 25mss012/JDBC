SQL> DECLARE
  2  v_marks NUMBER := 105;
  3  invalid_marks EXCEPTION;
  4  BEGIN
  5  IF v_marks > 100 OR v_marks < 0 THEN
  6  RAISE invalid_marks;
  7  END IF;
  8  DBMS_OUTPUT.PUT_LINE('Valid marks: ' || v_marks);
  9  EXCEPTION
 10  WHEN invalid_marks THEN
 11  DBMS_OUTPUT.PUT_LINE('Error: Marks should be between 0 and 100');
 12  END;
 13  /

PL/SQL procedure successfully completed.

